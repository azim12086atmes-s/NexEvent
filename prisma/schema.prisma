generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// ROLES: ADMIN, HOD, FACULTY, STUDENT
// ORGANIZER has been REMOVED - faculty in charge of a club organizes events
// Students with club permissions can also organize
// ============================================================

enum UserRole {
  STUDENT
  FACULTY
  HOD
  ADMIN
}

enum EventStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  LIVE
  COMPLETED
  CANCELLED
}

enum EventCategory {
  TECHNICAL
  CULTURAL
  SPORTS
  WORKSHOP
  SEMINAR
  HACKATHON
  SOCIAL
  OTHER
}

enum RegistrationStatus {
  REGISTERED
  CONFIRMED
  CANCELLED
  WAITLISTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum ClubApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CertificateType {
  PARTICIPATION
  WINNER
  RUNNER_UP
  BEST_PERFORMER
  SPECIAL_MENTION
  CUSTOM
}

enum CertificateScope {
  EVENT_WIDE     // Round-free, available to all who qualify
  ROUND_SPECIFIC  // Only for participants in this round
}

// ============================================================
// DEPARTMENT MODEL
// Every department has an HOD (User with HOD role)
// ============================================================

model Department {
  id          String   @id @default(cuid())
  name        String   @unique   // e.g., "Computer Science", "Electronics"
  code        String   @unique   // e.g., "CS", "EC"
  description String?
  hodId       String?  @unique   // One HOD per department
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hod         User?    @relation("DepartmentHOD", fields: [hodId], references: [id])
  clubs       Club[]
  events      Event[]
  users       User[]   @relation("DepartmentMembers")
}

// ============================================================
// USER MODEL
// - Admin approves HOD/Faculty role assignments
// - No account creation without authorization (approvalStatus)
// - HOD role is assigned to a User who then becomes department HOD
// ============================================================

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  avatar          String?
  role            UserRole @default(STUDENT)
  departmentId    String?                          // Which department they belong to
  usn             String?   // University Seat Number for students
  phone           String?
  passwordHash    String   @default("")
  isActive        Boolean  @default(true)
  approvalStatus  UserApprovalStatus @default(APPROVED) // Admin must approve HOD/Faculty roles
  googleId        String?   // Google OAuth ID
  googleEmail     String?   // Google email (may differ from institutional)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  department      Department? @relation("DepartmentMembers", fields: [departmentId], references: [id])
  clubMemberships       ClubMember[]
  organizedEvents       Event[]       @relation("EventOrganizer")
  approvedEvents        Event[]       @relation("EventApprover")
  registrations         EventRegistration[]
  attendances           Attendance[]
  facultyClubs          Club[]       @relation("FacultyAdvisor")
  clubRoleAssignments   ClubRoleAssignment[]
  eventRoleAssignments  EventRoleAssignment[]
  teamMemberships       TeamMember[]
  ledTeams              Team[]       @relation("TeamLeader")
  createdClubRoles      ClubRole[]   @relation("ClubRoleCreator")
  createdAchievements   ClubAchievement[]
  createdEventRoles     EventRole[]  @relation("EventRoleCreator")
  clubRoleAssignmentsMade ClubRoleAssignment[] @relation("ClubRoleAssigner")
  eventRoleAssignmentsMade EventRoleAssignment[] @relation("EventRoleAssigner")
  // HOD of department
  hodDepartment        Department?  @relation("DepartmentHOD")
  // Scoring
  scoresGiven          Score[]
  // Certificates
  certificates         Certificate[]
  // Location tracking
  locationPings        LocationPing[]
  // Club creation requests
  clubRequests         ClubCreationRequest[]
  // Approved clubs
  approvedClubs        Club[]       @relation("ClubApprover")
}

// ============================================================
// CLUB MODEL
// - Faculty requests club creation under a department → HOD approves
// - Two enrollment modes: auto-join or approval-required
// - Faculty in-charge (advisor) organizes events for the club
// ============================================================

model Club {
  id              String   @id @default(cuid())
  name            String   @unique
  slug            String   @unique
  description     String
  logo            String?
  coverImage      String?
  category        EventCategory @default(OTHER)
  isActive        Boolean  @default(true)
  foundedYear     Int?
  facultyAdvisorId String?
  departmentId    String                          // Club must belong to a department
  approvalStatus  ClubApprovalStatus @default(APPROVED) // PENDING until HOD approves
  approvedById    String?                         // HOD who approved
  approvedAt      DateTime?
  // Enrollment settings
  autoJoin        Boolean  @default(false)  // If true, students can auto-enroll
  requireApproval Boolean  @default(true)   // If true, students need club approval to join
  // Club page fields
  mission         String?
  vision          String?
  highlights      String?   // JSON string: [{title, description, icon}]
  socialLinks     String?   // JSON string: {instagram, twitter, linkedin, website}
  contactEmail    String?
  contactPhone    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  facultyAdvisor  User?       @relation("FacultyAdvisor", fields: [facultyAdvisorId], references: [id])
  department      Department  @relation(fields: [departmentId], references: [id])
  approver        User?       @relation("ClubApprover", fields: [approvedById], references: [id])
  members         ClubMember[]
  events          Event[]
  roles           ClubRole[]
  achievements    ClubAchievement[]
  roleAssignments ClubRoleAssignment[]
}

model ClubMember {
  id        String   @id @default(cuid())
  userId    String
  clubId    String
  role      String   @default("member") // president, secretary, treasurer, member - base role
  joinedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  club      Club     @relation(fields: [clubId], references: [id])

  @@unique([userId, clubId])
}

// Custom roles within clubs with granular permissions
model ClubRole {
  id          String   @id @default(cuid())
  clubId      String
  name        String   // e.g., "Event Coordinator", "Social Media Manager"
  description String?
  permissions String   @default("[]") // JSON array: ["EDIT_CLUB_PAGE", "CREATE_CLUB_EVENT", "MANAGE_MEMBERS", "MANAGE_ROLES", "VIEW_ANALYTICS", "MANAGE_ACHIEVEMENTS", "ORGANIZE_EVENTS"]
  isDefault   Boolean  @default(false) // Whether this is a system role
  color       String?  // Optional color for badge display
  createdBy   String
  createdAt   DateTime @default(now())

  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  assignments ClubRoleAssignment[]
  creator     User     @relation("ClubRoleCreator", fields: [createdBy], references: [id])
}

// Assigning club roles to users (with delegation tracking)
model ClubRoleAssignment {
  id          String   @id @default(cuid())
  clubRoleId  String
  userId      String
  clubId      String
  assignedBy  String   // Who assigned this role
  assignedAt  DateTime @default(now())

  role        ClubRole @relation(fields: [clubRoleId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])
  club        Club     @relation(fields: [clubId], references: [id])
  assigner    User     @relation("ClubRoleAssigner", fields: [assignedBy], references: [id])

  @@unique([clubRoleId, userId])
}

// Club achievements and awards
model ClubAchievement {
  id          String   @id @default(cuid())
  clubId      String
  title       String
  description String?
  date        DateTime @default(now())
  icon        String?  // Emoji or icon name
  category    String?  // e.g., "award", "milestone", "competition"
  createdBy   String
  createdAt   DateTime @default(now())

  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  creator     User     @relation(fields: [createdBy], references: [id])
}

// Club creation request - Faculty requests, HOD approves
model ClubCreationRequest {
  id          String   @id @default(cuid())
  name        String
  slug        String
  description String
  category    EventCategory @default(OTHER)
  requestedById String
  departmentId String
  hodId       String?                         // HOD who will review
  status      ClubApprovalStatus @default(PENDING)
  reviewedById String?
  reviewedAt  DateTime?
  rejectionReason String?
  facultyAdvisorId String?
  autoJoin    Boolean  @default(false)
  requireApproval Boolean @default(true)
  createdAt   DateTime @default(now())

  requestedBy User     @relation("ClubRequester", fields: [requestedById], references: [id])
  department  Department @relation(fields: [departmentId], references: [id])
  reviewedBy  User?    @relation("ClubReviewer", fields: [reviewedById], references: [id])
}

// ============================================================
// EVENT MODEL
// - Can be department-specific (under a department)
// - Can be under a club
// - Faculty/HOD approval workflow for event creation
// ============================================================

model Event {
  id                String       @id @default(cuid())
  title             String
  slug              String       @unique
  description       String
  poster            String?      // URL to event poster image
  category          EventCategory @default(OTHER)
  status            EventStatus  @default(DRAFT)
  venue             String
  venueLat          Float?
  venueLng          Float?
  geoFenceRadius    Float?       // in meters
  startDate         DateTime
  endDate           DateTime
  registrationDeadline DateTime?
  maxParticipants   Int?
  isPublic          Boolean      @default(true)
  requiresApproval  Boolean      @default(false)
  tags              String       @default("") // comma-separated tags
  organizerId       String
  approverId        String?
  approvedAt        DateTime?
  rejectionReason   String?
  // Event type extension
  eventType         String       @default("GENERAL") // GENERAL, COMPETITION
  // Department relation for department-wise events
  departmentId      String?      // If set, this is a department-specific event
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  organizer         User         @relation("EventOrganizer", fields: [organizerId], references: [id])
  approver          User?        @relation("EventApprover", fields: [approverId], references: [id])
  club              Club?        @relation(fields: [clubId], references: [id])
  clubId            String?
  department        Department?  @relation(fields: [departmentId], references: [id])
  registrations     EventRegistration[]
  attendances       Attendance[]
  report            EventReport?
  eventRoles        EventRole[]
  competitionConfig CompetitionConfig?
  teams             Team[]
  certificates      Certificate[]
}

model EventRegistration {
  id              String             @id @default(cuid())
  eventId         String
  userId          String
  status          RegistrationStatus @default(REGISTERED)
  qrCode          String?            // unique QR code identifier
  registeredAt    DateTime           @default(now())
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  // Team support for competitions
  teamId          String?
  // Current round for competition tracking
  currentRoundId  String?            // Which round the participant/team is currently in

  event           Event              @relation(fields: [eventId], references: [id])
  user            User               @relation(fields: [userId], references: [id])
  attendance      Attendance?

  @@unique([eventId, userId])
}

// ============================================================
// ATTENDANCE - Enhanced with live geo-tracking
// Instead of a single check-in, we track location pings
// Attendance % = time within fence / total event duration
// ============================================================

model Attendance {
  id              String           @id @default(cuid())
  registrationId  String           @unique
  eventId         String
  userId          String
  status          AttendanceStatus @default(PRESENT)
  checkInTime     DateTime         @default(now())
  checkInLat      Float?
  checkInLng      Float?
  isWithinGeoFence Boolean         @default(true)
  notes           String?
  // Live tracking fields
  attendancePercentage Float  @default(0)  // % of time within geo-fence
  lastPingTime    DateTime?                // Last location ping received
  totalPingsInFence Int     @default(0)   // Total pings within fence
  totalPings       Int      @default(0)   // Total pings received
  checkOutTime    DateTime?               // When they left/left the event

  registration    EventRegistration @relation(fields: [registrationId], references: [id])
  event           Event            @relation(fields: [eventId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
}

// Location pings for live tracking
model LocationPing {
  id          String   @id @default(cuid())
  userId      String
  eventId     String
  latitude    Float
  longitude   Float
  isWithinFence Boolean
  pingedAt    DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  event       Event    @relation(fields: [eventId], references: [id])
}

model EventReport {
  id              String   @id @default(cuid())
  eventId         String   @unique
  totalRegistered Int      @default(0)
  totalPresent    Int      @default(0)
  totalAbsent     Int      @default(0)
  attendanceRate  Float    @default(0)
  summary         String?
  pdfUrl          String?
  generatedAt     DateTime @default(now())

  event           Event    @relation(fields: [eventId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info") // info, success, warning, error
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

// ============================================================
// EVENT ROLES & SCORING
// Faculty/organizer creates judgment parameters for judges
// Judges score participants on criteria per round
// ============================================================

model EventRole {
  id           String   @id @default(cuid())
  eventId      String
  name         String   // e.g., "Judge", "Evaluator", "Volunteer", "Student Staff"
  description  String?
  permissions  String   @default("[]") // JSON array: ["SCORE_PARTICIPANTS", "VIEW_RESULTS", "MANAGE_REGISTRATIONS", "CHECK_IN_ATTENDEES", "MANAGE_EVENT_ROLES"]
  color        String?  // Optional color for badge
  maxAssignees Int?     // Optional limit on how many people can have this role
  createdBy    String
  createdAt    DateTime @default(now())

  event       Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignments EventRoleAssignment[]
  creator     User               @relation("EventRoleCreator", fields: [createdBy], references: [id])
}

model EventRoleAssignment {
  id          String   @id @default(cuid())
  eventRoleId String
  userId      String
  assignedBy  String
  assignedAt  DateTime @default(now())

  role        EventRole @relation(fields: [eventRoleId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])
  assigner    User      @relation("EventRoleAssigner", fields: [assignedBy], references: [id])

  @@unique([eventRoleId, userId])
}

// Competition configuration (1:1 with Event)
model CompetitionConfig {
  id              String   @id @default(cuid())
  eventId         String   @unique
  teamMinSize     Int      @default(1)   // Minimum members per team
  teamMaxSize     Int      @default(5)   // Maximum members per team
  maxTeams        Int?                   // Maximum number of teams (null = unlimited)
  allowIndividual Boolean  @default(true) // Can individuals participate without a team?
  scoringType     String   @default("CUMULATIVE") // CUMULATIVE, AVERAGE, BEST_OF
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event           Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rounds          CompetitionRound[]
}

// Competition rounds with scoring criteria
model CompetitionRound {
  id                  String   @id @default(cuid())
  competitionConfigId String
  roundNumber         Int      // 1, 2, 3...
  name                String   // e.g., "Prelims", "Semifinals", "Finals"
  description         String?
  criteria            String   @default("[]") // JSON array: [{name, description, maxScore, weight}]
  maxScore            Float    @default(100)
  weight              Float    @default(1.0) // Weight of this round in final score
  isElimination       Boolean  @default(false) // Does this round eliminate teams?
  advanceCount        Int?     // How many teams advance (if elimination)
  isActive            Boolean  @default(true)
  // Scoring visibility - when should judges be able to score?
  scoringOpen         Boolean  @default(false) // Whether scoring is open for judges
  scoringDeadline     DateTime? // When scoring closes for this round
  createdAt           DateTime @default(now())

  config              CompetitionConfig @relation(fields: [competitionConfigId], references: [id], onDelete: Cascade)
  scores              Score[]
  certificates        Certificate[]
}

// ============================================================
// SCORING MODEL
// Each judge scores each participant/team on each criterion per round
// ============================================================

model Score {
  id          String   @id @default(cuid())
  roundId     String
  judgeId     String   // User who is scoring (must have SCORE_PARTICIPANTS permission)
  targetId    String   // userId (individual) or teamId being scored
  targetType  String   @default("INDIVIDUAL") // INDIVIDUAL or TEAM
  criterionName String  // Name of the criterion from the round's criteria JSON
  score       Float   // Score given by judge
  maxScore    Float   // Max possible for this criterion
  weight      Float   @default(1.0)
  comments    String? // Judge's comments
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  round       CompetitionRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  judge       User             @relation(fields: [judgeId], references: [id])

  @@unique([roundId, judgeId, targetId, criterionName])
}

// Teams for competition events
model Team {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  teamCode  String   @unique // Unique join code
  leaderId  String
  status    String   @default("REGISTERED") // REGISTERED, CONFIRMED, ELIMINATED, WINNER
  currentRoundId String? // Which round the team is currently in
  createdAt DateTime @default(now())

  event     Event        @relation(fields: [eventId], references: [id])
  leader    User         @relation("TeamLeader", fields: [leaderId], references: [id])
  members   TeamMember[]
}

// Team members
model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  joinedAt  DateTime @default(now())

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
}

// ============================================================
// CERTIFICATE MODEL
// - Round-based certificates: students in that round get that cert
// - Round-free certificates: anyone who qualifies gets it
// - Participation certificates for eliminated teams (default option)
// - Organizer chooses how many certificate types and for which rounds
// ============================================================

model Certificate {
  id              String   @id @default(cuid())
  eventId         String
  roundId         String?  // null = event-wide (round-free)
  userId          String?  // null = template, not yet issued
  title           String   // e.g., "Participation Certificate", "Winner Certificate"
  description     String?
  certificateType CertificateType @default(PARTICIPATION)
  scope           CertificateScope @default(EVENT_WIDE)
  // Template fields for generating the certificate
  templateData    String?  // JSON: {bgColor, logoPosition, textPosition, fontStyle, etc.}
  issuedAt        DateTime?
  certificateUrl  String?  // URL to the generated certificate PDF/image
  // For round-based certs
  isDefault       Boolean  @default(false) // Automatically issued to all participants in the round
  createdAt       DateTime @default(now())

  event           Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  round           CompetitionRound?  @relation(fields: [roundId], references: [id])
  user            User?              @relation(fields: [userId], references: [id])
}
