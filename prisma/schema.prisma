generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  ORGANIZER
  FACULTY
  ADMIN
}

enum EventStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  LIVE
  COMPLETED
  CANCELLED
}

enum EventCategory {
  TECHNICAL
  CULTURAL
  SPORTS
  WORKSHOP
  SEMINAR
  HACKATHON
  SOCIAL
  OTHER
}

enum RegistrationStatus {
  REGISTERED
  CONFIRMED
  CANCELLED
  WAITLISTED
}

enum AttendanceStatus {
  PRESENT
  ABENT
  LATE
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  avatar        String?
  role          UserRole @default(STUDENT)
  department    String?
  usn           String?  // University Seat Number for students
  phone         String?
  passwordHash  String   @default("")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clubMemberships       ClubMember[]
  organizedEvents       Event[]       @relation("EventOrganizer")
  approvedEvents        Event[]       @relation("EventApprover")
  registrations         EventRegistration[]
  attendances           Attendance[]
  facultyClubs          Club[]       @relation("FacultyAdvisor")
  clubRoleAssignments   ClubRoleAssignment[]
  eventRoleAssignments  EventRoleAssignment[]
  teamMemberships       TeamMember[]
  ledTeams              Team[]       @relation("TeamLeader")
  createdClubRoles      ClubRole[]   @relation("ClubRoleCreator")
  createdAchievements   ClubAchievement[]
  createdEventRoles     EventRole[]  @relation("EventRoleCreator")
  clubRoleAssignmentsMade ClubRoleAssignment[] @relation("ClubRoleAssigner")
  eventRoleAssignmentsMade EventRoleAssignment[] @relation("EventRoleAssigner")
}

model Club {
  id              String   @id @default(cuid())
  name            String   @unique
  slug            String   @unique
  description     String
  logo            String?
  coverImage      String?
  category        EventCategory @default(OTHER)
  isActive        Boolean  @default(true)
  foundedYear     Int?
  facultyAdvisorId String?
  // Club page fields
  mission         String?   // What the club stands for
  vision          String?   // Club vision
  highlights      String?   // JSON string: [{title, description, icon}]
  socialLinks     String?   // JSON string: {instagram, twitter, linkedin, website}
  contactEmail    String?
  contactPhone    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  facultyAdvisor  User?       @relation("FacultyAdvisor", fields: [facultyAdvisorId], references: [id])
  members         ClubMember[]
  events          Event[]
  roles           ClubRole[]
  achievements    ClubAchievement[]
  roleAssignments ClubRoleAssignment[]
}

model ClubMember {
  id        String   @id @default(cuid())
  userId    String
  clubId    String
  role      String   @default("member") // president, secretary, treasurer, member - base role
  joinedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  club      Club     @relation(fields: [clubId], references: [id])

  @@unique([userId, clubId])
}

// Custom roles within clubs with granular permissions
model ClubRole {
  id          String   @id @default(cuid())
  clubId      String
  name        String   // e.g., "Event Coordinator", "Social Media Manager"
  description String?
  permissions String   @default("[]") // JSON array: ["EDIT_CLUB_PAGE", "CREATE_CLUB_EVENT", "MANAGE_MEMBERS", "MANAGE_ROLES", "VIEW_ANALYTICS", "MANAGE_ACHIEVEMENTS"]
  isDefault   Boolean  @default(false) // Whether this is a system role
  color       String?  // Optional color for badge display
  createdBy   String
  createdAt   DateTime @default(now())

  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  assignments ClubRoleAssignment[]
  creator     User     @relation("ClubRoleCreator", fields: [createdBy], references: [id])
}

// Assigning club roles to users (with delegation tracking)
model ClubRoleAssignment {
  id          String   @id @default(cuid())
  clubRoleId  String
  userId      String
  clubId      String
  assignedBy  String   // Who assigned this role
  assignedAt  DateTime @default(now())

  role        ClubRole @relation(fields: [clubRoleId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])
  club        Club     @relation(fields: [clubId], references: [id])
  assigner    User     @relation("ClubRoleAssigner", fields: [assignedBy], references: [id])

  @@unique([clubRoleId, userId])
}

// Club achievements and awards
model ClubAchievement {
  id          String   @id @default(cuid())
  clubId      String
  title       String
  description String?
  date        DateTime @default(now())
  icon        String?  // Emoji or icon name
  category    String?  // e.g., "award", "milestone", "competition"
  createdBy   String
  createdAt   DateTime @default(now())

  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  creator     User     @relation(fields: [createdBy], references: [id])
}

model Event {
  id                String       @id @default(cuid())
  title             String
  slug              String       @unique
  description       String
  poster            String?      // URL to event poster image
  category          EventCategory @default(OTHER)
  status            EventStatus  @default(DRAFT)
  venue             String
  venueLat          Float?
  venueLng          Float?
  geoFenceRadius    Float?       // in meters
  startDate         DateTime
  endDate           DateTime
  registrationDeadline DateTime?
  maxParticipants   Int?
  isPublic          Boolean      @default(true)
  requiresApproval  Boolean      @default(false)
  tags              String       @default("") // comma-separated tags
  organizerId       String
  approverId        String?
  approvedAt        DateTime?
  rejectionReason   String?
  // Event type extension
  eventType         String       @default("GENERAL") // GENERAL, COMPETITION
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  organizer         User         @relation("EventOrganizer", fields: [organizerId], references: [id])
  approver          User?        @relation("EventApprover", fields: [approverId], references: [id])
  club              Club?        @relation(fields: [clubId], references: [id])
  clubId            String?
  registrations     EventRegistration[]
  attendances       Attendance[]
  report            EventReport?
  eventRoles        EventRole[]
  competitionConfig CompetitionConfig?
  teams             Team[]
}

model EventRegistration {
  id              String             @id @default(cuid())
  eventId         String
  userId          String
  status          RegistrationStatus @default(REGISTERED)
  qrCode          String?            // unique QR code identifier
  registeredAt    DateTime           @default(now())
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  // Team support for competitions
  teamId          String?

  event           Event              @relation(fields: [eventId], references: [id])
  user            User               @relation(fields: [userId], references: [id])
  attendance      Attendance?

  @@unique([eventId, userId])
}

model Attendance {
  id              String           @id @default(cuid())
  registrationId  String           @unique
  eventId         String
  userId          String
  status          AttendanceStatus @default(PRESENT)
  checkInTime     DateTime         @default(now())
  checkInLat      Float?
  checkInLng      Float?
  isWithinGeoFence Boolean         @default(true)
  notes           String?

  registration    EventRegistration @relation(fields: [registrationId], references: [id])
  event           Event            @relation(fields: [eventId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
}

model EventReport {
  id              String   @id @default(cuid())
  eventId         String   @unique
  totalRegistered Int      @default(0)
  totalPresent    Int      @default(0)
  totalAbsent     Int      @default(0)
  attendanceRate  Float    @default(0)
  summary         String?
  pdfUrl          String?
  generatedAt     DateTime @default(now())

  event           Event    @relation(fields: [eventId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info") // info, success, warning, error
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

// Custom roles for events (evaluators, judges, volunteers, etc.)
model EventRole {
  id           String   @id @default(cuid())
  eventId      String
  name         String   // e.g., "Judge", "Evaluator", "Volunteer", "Student Staff"
  description  String?
  permissions  String   @default("[]") // JSON array: ["SCORE_PARTICIPANTS", "VIEW_RESULTS", "MANAGE_REGISTRATIONS", "CHECK_IN_ATTENDEES", "MANAGE_EVENT_ROLES"]
  color        String?  // Optional color for badge
  maxAssignees Int?     // Optional limit on how many people can have this role
  createdBy    String
  createdAt    DateTime @default(now())

  event       Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignments EventRoleAssignment[]
  creator     User               @relation("EventRoleCreator", fields: [createdBy], references: [id])
}

// Assigning event roles to users
model EventRoleAssignment {
  id          String   @id @default(cuid())
  eventRoleId String
  userId      String
  assignedBy  String
  assignedAt  DateTime @default(now())

  role        EventRole @relation(fields: [eventRoleId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])
  assigner    User      @relation("EventRoleAssigner", fields: [assignedBy], references: [id])

  @@unique([eventRoleId, userId])
}

// Competition configuration (1:1 with Event)
model CompetitionConfig {
  id              String   @id @default(cuid())
  eventId         String   @unique
  teamMinSize     Int      @default(1)   // Minimum members per team
  teamMaxSize     Int      @default(5)   // Maximum members per team
  maxTeams        Int?                   // Maximum number of teams (null = unlimited)
  allowIndividual Boolean  @default(true) // Can individuals participate without a team?
  scoringType     String   @default("CUMULATIVE") // CUMULATIVE, AVERAGE, BEST_OF
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event           Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rounds          CompetitionRound[]
}

// Competition rounds with scoring criteria
model CompetitionRound {
  id                  String   @id @default(cuid())
  competitionConfigId String
  roundNumber         Int      // 1, 2, 3...
  name                String   // e.g., "Prelims", "Semifinals", "Finals"
  description         String?
  criteria            String   @default("[]") // JSON array: [{name, description, maxScore, weight}]
  maxScore            Float    @default(100)
  weight              Float    @default(1.0) // Weight of this round in final score
  isElimination       Boolean  @default(false) // Does this round eliminate teams?
  advanceCount        Int?     // How many teams advance (if elimination)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())

  config              CompetitionConfig @relation(fields: [competitionConfigId], references: [id], onDelete: Cascade)
}

// Teams for competition events
model Team {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  teamCode  String   @unique // Unique join code
  leaderId  String
  status    String   @default("REGISTERED") // REGISTERED, CONFIRMED, ELIMINATED, WINNER
  createdAt DateTime @default(now())

  event     Event        @relation(fields: [eventId], references: [id])
  leader    User         @relation("TeamLeader", fields: [leaderId], references: [id])
  members   TeamMember[]
}

// Team members
model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  joinedAt  DateTime @default(now())

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
}
